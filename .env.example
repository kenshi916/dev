# Configure CREDENTIAL_SECRET as a secret on the production host.
# For local development, run node scripts/init-local.mjs to create .dev.vars.
# Never replace an active encryption secret without migrating stored credentials.
CREDENTIAL_SECRET=

# Optional operator-controlled mainnet RPC for public launch verification.
# Defaults to Solana's public mainnet endpoint, which may rate-limit requests.
# Owner-supplied RPC endpoints cannot attest public Activity events.
DEV_PUBLIC_SOLANA_RPC=

# Optional Dev-sponsored OpenRouter access. Disabled until an operator explicitly configures it.
# These are server-only Cloudflare secrets/bindings; never use NEXT_PUBLIC_ or expose them to the client.
DEV_SPONSORED_AI_ENABLED=false
OPENROUTER_MANAGEMENT_KEY=
# Exact authenticated ChatGPT owner IDs, comma-separated. No wildcard/public auto-enrollment.
DEV_SPONSORED_AI_OWNERS=
# Required per-owner provider-enforced daily USD cap, 0.01 through 100.00; resets at midnight UTC.
DEV_SPONSORED_AI_DAILY_USD=1.00
# This cap is not a funded balance. Fund the platform OpenRouter account separately.
# No credit purchases, creator-fee conversion, or automatic top-ups are implemented here.
# After uncertain child-key creation, reconcile/revoke the named attempt in OpenRouter before
# manually resetting settings.ai_sponsored_access_v1. Never delete the record to blindly retry.
